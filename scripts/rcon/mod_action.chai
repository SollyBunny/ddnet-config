// scripts/rcon/mod_action.chai

import("re")

def trim(str) {
	var start = 0
	var end = str.size() - 1
	while (start < str.size() && str[start] == " ") {
		++start
	}
	while (end >= start && str[end] == " ") {
		--end
	}
	return str.substr(start, end - start + 1)
}

def join(l) {
	return join(l, "")
}

def parse_duration(str) {
	var duration = ""
	var unit = ""
	re.match(re.compile("^(\\d+)(\\w?)$"), str, false, fun[duration, unit](str, match, group) {
		if (group == 1) {
			duration = str
		} else if (group == 2) {
			unit = str
		}
	})
	if (duration == "") {
		throw("No duration given")
	}
	var mult
	if (unit == "") {
		mult = 60
	} else if (unit == "s" || unit == "S") {
		mult = 1
	} else if (unit == "m" || unit == "M") {
		mult = 60
	} else if (unit == "h" || unit == "H") {
		mult = 3600
	} else if (unit == "d" || unit == "D") {
		mult = 86400
	} else if (unit == "w" || unit == "W") {
		mult = 604800
	} else {
		throw("Invalid duration unit")
	}
	return to_int(duration) * mult
}

var args_parsed = args
var what_sub = ""
var args_sub = ""
var id_sub = ""
re.match(re.compile("^idlast (.+?) (.+? )?(\\d+)$"), args, false, fun[what_sub, args_sub, id_sub](str, match, group) {
	if (group == 1) {
		what_sub = str
	} else if (group == 2) {
		args_sub = str
	} else if (group == 3) {
		id_sub = str
	}
})
print(args)
if (what_sub != "" && id_sub != "") {
	print(what_sub)
	print(args_sub)
	print(id_sub)
	args_parsed = join([what_sub, " ", id_sub, " ", args_sub])
}

var what = ""
var id_raw = ""
var duration = ""
var reason = ""
re.match(re.compile("^(.+?) +(\\d+?)(?: +|$)(.*?)(?: +|$)(.+?)? *$"), args_parsed, false, fun[what, id_raw, duration, reason](str, match, group) {
	if (group == 1) {
		what = str
	} else if (group == 2) {
		id_raw = str
	} else if (group == 3) {
		duration = str
	} else if (group == 4) {
		reason = str
	}
})

if (what == "" || id_raw == "") {
	throw("Not enough arguments")
}

var id = to_int(id_raw)
var name = state("name", id)

if (what == "kill") {
	reason = trim(duration + " " + reason)
	if (reason == "") { reason = "No reason given" }
	echo(join(["Kill ", id, ": ", name, " (", reason, ")"]))
	exec(join(["rcon kill_pl ", id, " ", reason]))
} else if (what == "kill_silent") {
	reason = trim(duration + " " + reason)
	if (reason == "") { reason = "No reason given" }
	echo(join(["Kill silent ", id, ": ", name, " (", reason, ")"]))
	exec(join(["rcon set_team ", id, " -1"]))
	exec(join(["rcon set_team ", id, " 0"]))
} else if (what == "kick") {
	reason = trim(duration + " " + reason)
	if (reason == "") { reason = "No reason given" }
	echo(join(["Kick ", id, ": ", name, " (", reason, ")"]))
	exec(join(["rcon kick ", id, " ", reason]))
} else if (what == "mute") {
	if (reason == "") { reason = "No reason given" }
	var duration_parsed = parse_duration(duration)
	echo(join(["Mute ", id, ": ", name, " for ", duration, " (", reason, ")"]))
	exec(join(["rcon muteid ", id, " ", duration_parsed, " ", reason]))
} else if (what == "unmute") {
	echo(join(["Unmute ", id, ": ", name]))
	exec(join(["rcon unmuteid ", id]))
} else if (what == "ban") {
	if (reason == "") { throw("No reason given") }
	echo(join(["Ban ", id, ": ", name, " for ", duration, " (", reason, ")"]))
	exec(join(["rcon set_team ", id, " -1"]))
	exec(join(["webhook_command ban ", id, " ", duration, " ", reason]))
} else {
	throw("Unknown what")
}
